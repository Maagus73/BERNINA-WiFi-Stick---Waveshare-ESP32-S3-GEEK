# 16 MB Flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Primäre Konsole über USB Serial/JTAG
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# USB-Massenspeicher aktivieren
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=512

# FATFS: Lange Dateinamen aktivieren
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# Test 12c: 4 MiB Factory-App, NVS/PHY an bisherigen Adressen
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Test 14: Dateinamen in der FAT-Datei-API als UTF-8
CONFIG_FATFS_API_ENCODING_UTF_8=y

# Test 14a: bestaetigter ESP32-S3-GEEK mit 2 MB Quad-PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_MEMTEST=y

# Encoded search paths up to 1023 UTF-8 bytes; no silent truncation.
CONFIG_HTTPD_MAX_URI_LEN=4096
